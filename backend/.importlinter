[importlinter]
root_package = ugjcs
include_external_packages = True

[importlinter:contract:domain-purity]
name = Domain layer imports no framework, vendor SDK, or I/O module
type = forbidden
source_modules =
    ugjcs.domain
forbidden_modules =
    fastapi
    sqlalchemy
    pydantic
    boto3
    arq
    redis
    httpx
    requests
    os
    io
    socket
    sqlite3
    subprocess
    pathlib
    asyncio
    threading
    multiprocessing
    logging
    http
    smtplib
    urllib

[importlinter:contract:layers]
name = Dependencies point inwards only
type = layers
layers =
    ugjcs.infrastructure
    ugjcs.application
    ugjcs.domain
